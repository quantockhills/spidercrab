slider39:pattern_loop_length=32<2,64,1>-Loop length
slider40:cc_reset=102<0,255,1>-CC which resets MIDI position

// ---- Exposed for host control (generated) ----
// Hidden from this plugin's own UI with a leading "-", so it looks
// unchanged in REAPER while these remain automatable. Ranges are
// taken from how @gfx writes each variable, and names from the
// labels and tooltips its draw calls already carry.
slider41:loop_point=0<0,1,0.000001>-Loop Point
slider42:enable_vel=0<0,1,1>-Enable Velocity
slider43:enable_mod=0<0,1,1>-Enable Mod
slider44:enable_cc1=0<0,1,1>-Enable Cc1
