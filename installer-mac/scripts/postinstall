#!/bin/bash
# Spidercrab macOS installer — postinstall
#
# Runs after pkgbuild extracts this script's own bundle (which also
# contains reaper_spidercrab.dylib and frontend/, staged alongside this
# file at build time). Everything here is plain, readable shell — nothing
# hidden, nothing compiled.
#
# What it does, in order:
#   1. Find the real user's home directory (this script runs as root
#      during install, so $HOME/$USER point at root, not the person
#      installing it).
#   2. Copy the plugin + web UI into REAPER's UserPlugins folder.
#   3. Clear macOS's quarantine flag on what we just installed, so REAPER
#      doesn't hit the same "cannot be opened" Gatekeeper block the .pkg
#      itself already went through (files copied by the installer can
#      still inherit quarantine from the resources they came from).
#   4. Hand ownership back to the real user (step 2 ran as root).
#   5. Register the "spidercrab" OSC device in REAPER's global prefs
#      (reaper.ini), so ReaLearn's Input/Output device dropdowns have it
#      to pick from without a manual Preferences > Control/OSC/web step.
set -e

CONSOLE_USER=$(stat -f%Su /dev/console 2>/dev/null || true)
if [ -z "$CONSOLE_USER" ] || [ "$CONSOLE_USER" = "root" ]; then
  CONSOLE_USER="${SUDO_USER:-$USER}"
fi
USER_HOME=$(dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory 2>/dev/null | awk '{print $2}')
if [ -z "$USER_HOME" ]; then
  USER_HOME="$HOME"
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
DEST="$USER_HOME/Library/Application Support/REAPER/UserPlugins"

echo "Spidercrab: installing for user '$CONSOLE_USER' into: $DEST"

mkdir -p "$DEST"
cp "$SCRIPT_DIR/reaper_spidercrab.dylib" "$DEST/reaper_spidercrab.dylib"
rm -rf "$DEST/frontend"
cp -R "$SCRIPT_DIR/frontend" "$DEST/frontend"

xattr -dr com.apple.quarantine "$DEST/reaper_spidercrab.dylib" "$DEST/frontend" 2>/dev/null || true

chown -R "$CONSOLE_USER" "$DEST" 2>/dev/null || true

# ---- Register the OSC device REAPER/ReaLearn need for the Clip Launcher ----
# Only touches reaper.ini if it already exists (REAPER writes it on first
# launch — a never-yet-run REAPER has nothing to patch) and only if a
# "spidercrab" device isn't already registered. The new csurf_N line is
# inserted right after csurf_cnt so it lands inside the [reaper] section,
# not wherever happens to be last in the file.
REAPER_INI="$USER_HOME/Library/Application Support/REAPER/reaper.ini"
OSC_LINE='OSC "spidercrab" 6 9001 "127.0.0.1" 9011 1024 10 ""'
if [ -f "$REAPER_INI" ] && ! grep -qF "$OSC_LINE" "$REAPER_INI"; then
  if grep -q '^csurf_cnt=' "$REAPER_INI"; then
    awk -v newline="$OSC_LINE" '
      /^csurf_cnt=/ {
        cnt = $0
        sub(/^csurf_cnt=/, "", cnt)
        cnt = cnt + 0
        print "csurf_cnt=" (cnt + 1)
        print "csurf_" cnt "=" newline
        next
      }
      { print }
    ' "$REAPER_INI" > "$REAPER_INI.spidercrab-tmp" && mv "$REAPER_INI.spidercrab-tmp" "$REAPER_INI"
    chown "$CONSOLE_USER" "$REAPER_INI" 2>/dev/null || true
    echo "Spidercrab: registered the spidercrab OSC device in reaper.ini"
  else
    echo "Spidercrab: reaper.ini has no csurf_cnt key — skipping OSC auto-setup (add it manually via Preferences > Control/OSC/web if you use the Clip Launcher)"
  fi
else
  echo "Spidercrab: reaper.ini not found, or the OSC device is already registered — skipping"
fi

echo "Spidercrab: done."
exit 0
