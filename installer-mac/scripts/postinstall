#!/bin/bash
# Spidercrab macOS installer — postinstall
#
# Runs after pkgbuild extracts this script's own bundle (which also
# contains reaper_spidercrab.dylib and frontend/, staged alongside this
# file at build time). Everything here is plain, readable shell — nothing
# hidden, nothing compiled.
#
# What it does, in order:
#   1. Find the real user's home directory (this script runs as root
#      during install, so $HOME/$USER point at root, not the person
#      installing it).
#   2. Copy the plugin + web UI into REAPER's UserPlugins folder.
#   3. Clear macOS's quarantine flag on what we just installed, so REAPER
#      doesn't hit the same "cannot be opened" Gatekeeper block the .pkg
#      itself already went through (files copied by the installer can
#      still inherit quarantine from the resources they came from).
#   4. Hand ownership back to the real user (step 2 ran as root).
#   5. Register the "spidercrab" device in ReaLearn's OWN OSC device list
#      (Helgoboss/ReaLearn/osc.json — NOT reaper.ini, a completely separate
#      system ReaLearn's Input/Output dropdowns don't read from at all), so
#      those dropdowns have it to pick from without a manual "Manage OSC
#      devices" step.
set -e

CONSOLE_USER=$(stat -f%Su /dev/console 2>/dev/null || true)
if [ -z "$CONSOLE_USER" ] || [ "$CONSOLE_USER" = "root" ]; then
  CONSOLE_USER="${SUDO_USER:-$USER}"
fi
USER_HOME=$(dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory 2>/dev/null | awk '{print $2}')
if [ -z "$USER_HOME" ]; then
  USER_HOME="$HOME"
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
DEST="$USER_HOME/Library/Application Support/REAPER/UserPlugins"

echo "Spidercrab: installing for user '$CONSOLE_USER' into: $DEST"

mkdir -p "$DEST"
cp "$SCRIPT_DIR/reaper_spidercrab.dylib" "$DEST/reaper_spidercrab.dylib"
rm -rf "$DEST/frontend"
cp -R "$SCRIPT_DIR/frontend" "$DEST/frontend"

xattr -dr com.apple.quarantine "$DEST/reaper_spidercrab.dylib" "$DEST/frontend" 2>/dev/null || true

chown -R "$CONSOLE_USER" "$DEST" 2>/dev/null || true

# ---- Register the spidercrab device in ReaLearn's own OSC device list ----
# The UUID below is fixed (not randomly generated) on purpose: it has to
# match the id embedded in any ReaLearn "unit" export we ship, or an
# imported unit's controlDeviceId/feedbackDeviceId reference wouldn't
# resolve to this device.
OSC_JSON="$USER_HOME/Library/Application Support/REAPER/Helgoboss/ReaLearn/osc.json"
DEVICE_OBJ='{"id":"5fb52133-18ef-489b-b7a9-57152d58db98","name":"spidercrab","localPort":9001,"deviceHost":"127.0.0.1","devicePort":9011}'

if [ -f "$OSC_JSON" ] && grep -qF '"spidercrab"' "$OSC_JSON"; then
  echo "Spidercrab: spidercrab OSC device already present in osc.json — skipping"
elif [ ! -f "$OSC_JSON" ]; then
  mkdir -p "$(dirname "$OSC_JSON")"
  printf '{"devices":[%s]}' "$DEVICE_OBJ" > "$OSC_JSON"
  chown "$CONSOLE_USER" "$OSC_JSON" 2>/dev/null || true
  echo "Spidercrab: created osc.json with the spidercrab OSC device"
elif grep -q '"devices"' "$OSC_JSON"; then
  # Insert right after the "devices" array's opening bracket. JSON forbids
  # a trailing comma, so whether the array was empty or not decides
  # whether the inserted object needs one after it.
  awk -v dev="$DEVICE_OBJ" '
    BEGIN { RS="\x00" }
    {
      content = $0
      devPos = index(content, "\"devices\"")
      tail = substr(content, devPos)
      brPosRel = index(tail, "[")
      absBracket = devPos + brPosRel - 1
      rest = substr(content, absBracket + 1)
      trimmed = rest
      gsub(/^[ \t\r\n]+/, "", trimmed)
      if (substr(trimmed, 1, 1) == "]") { insertion = dev } else { insertion = dev "," }
      result = substr(content, 1, absBracket) insertion rest
      printf "%s", result
    }
  ' "$OSC_JSON" > "$OSC_JSON.spidercrab-tmp" && mv "$OSC_JSON.spidercrab-tmp" "$OSC_JSON"
  chown "$CONSOLE_USER" "$OSC_JSON" 2>/dev/null || true
  echo "Spidercrab: registered the spidercrab OSC device in osc.json"
else
  echo "Spidercrab: osc.json has no \"devices\" key — skipping OSC auto-setup (unexpected format)"
fi

echo "Spidercrab: done."
exit 0
